# Copy this file to .env and fill in your Spotify app's Client ID.
# Create/find it at https://developer.spotify.com/dashboard and register the
# redirect URI http://127.0.0.1:8888/callback on the app. A hosted copy gets
# its Client ID from the host's build settings instead (README "Hosting").
# The Client ID is not a secret (PKCE needs no client secret), but keep .env
# out of git anyway; it is already in .gitignore.
VITE_SPOTIFY_CLIENT_ID=your-client-id-here
